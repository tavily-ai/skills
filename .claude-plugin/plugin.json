{
  "name": "tavily",
  "version": "2.4.0",
  "description": "Build AI applications with real-time web data using Tavily's search, extract, crawl, and research APIs.",
  "author": {
    "name": "Tavily Team",
    "email": "tavily-integrations@nebius.com",
    "url": "https://www.tavily.com/"
  },
  "homepage": "https://docs.tavily.com",
  "privacyPolicyUrl": "https://www.tavily.com/privacy",
  "repository": "https://github.com/tavily-ai/skills",
  "license": "MIT",
  "keywords": [
    "search",
    "web-search",
    "rag",
    "agents",
    "llm",
    "research",
    "crawl",
    "extract"
  ],
  "skills": [
    "./skills/core/",
    "./skills/tasks/",
    "./skills/developers/"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "awk 'f>=2; /^---$/{f++}' \"${CLAUDE_PLUGIN_ROOT}/rules/tavily-awareness.mdc\""
          }
        ]
      }
    ]
  }
}
